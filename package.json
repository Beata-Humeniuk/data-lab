{
  "name": "data-lab",
  "displayName": "DataLab",
  "description": "%description%",
  "version": "1.1.0",
  "publisher": "beatahumeniuk",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Beata-Humeniuk/data-lab.git"
  },
  "homepage": "https://github.com/Beata-Humeniuk/data-lab#readme",
  "bugs": {
    "url": "https://github.com/Beata-Humeniuk/data-lab/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "json",
    "xml",
    "yaml",
    "csv",
    "transform",
    "sample data",
    "table",
    "mapping"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "restrictedConfigurations": [
        "dataLab.labsFolder",
        "dataLab.useSpecPackage"
      ]
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "DataLab",
      "properties": {
        "dataLab.labsFolder": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.labsFolder.description%"
        },
        "dataLab.useSpecPackage": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.useSpecPackage.description%"
        }
      }
    },
    "commands": [
      {
        "command": "dataLab.open",
        "title": "%command.open.title%",
        "category": "DataLab",
        "icon": "$(beaker)"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.js --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify --charset=utf8",
    "vscode:prepublish": "npm run build",
    "test": "node test/nls-test.js && node test/sample-formats-test.js && node test/data-pipeline-test.js && node test/flatten-test.js && node test/lab-pick-test.js && node test/labs-folder-test.js && node test/lab-view-smoke-test.js && node test/theme-scheme-test.js",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.21.5"
  }
}
